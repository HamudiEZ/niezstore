# ─── Base de datos ────────────────────────────────────────────────────────────
# Cadena de conexión de PostgreSQL.
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_DB?schema=public&uselibpqcompat=true
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/niezstore?schema=public&uselibpqcompat=true"

# ─── Admin inicial (usado por el seed) ────────────────────────────────────────
# Email del primer administrador que crea el seed.
SEED_ADMIN_EMAIL="admin@tudominio.com"
SEED_ADMIN_FULL_NAME="Admin"
# Hash bcrypt del password del admin (generado con bcrypt rounds=12).
# Nunca guardes el password en texto plano.
SEED_ADMIN_PASSWORD_HASH="$2b$12$REEMPLAZA_CON_TU_HASH_BCRYPT"

# ─── Cloudinary (almacenamiento de imágenes) ──────────────────────────────────
# Encontrás estos valores en: https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"
